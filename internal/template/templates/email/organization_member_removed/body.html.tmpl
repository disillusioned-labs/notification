<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Removed — {{.OrganizationName}}</title>
</head>

<body style="
  margin:0;
  padding:0;
  background:#c8c8c8;
  color:#111111;
  font-family:Arial, Helvetica, sans-serif;
">

<!-- PREHEADER -->
<div style="
  display:none;
  max-height:0;
  overflow:hidden;
  opacity:0;
 ">
  You've been removed from {{.OrganizationName}}.
</div>

<!-- PAGE -->
<table width="100%" cellpadding="0" cellspacing="0" border="0"
  style="background:#c8c8c8; padding:35px 10px;">

<tr>
<td align="center">

<!-- MAIN WINDOW -->
<table width="100%" cellpadding="0" cellspacing="0" border="0"
  style="
    max-width:620px;
    background:#efefef;
    border:1px solid #555555;
    box-shadow:4px 4px 0 #888888;
  ">

<!-- TITLE BAR -->
<tr>
<td style="
  background:#173b72;
  color:#ffffff;
  padding:6px 9px;
">
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td style="
        font-family:Arial, Helvetica, sans-serif;
        font-size:11px;
        font-weight:bold;
      ">
        DISILLUSIONED LABS
      </td>
      <td align="right" style="
        font-size:11px;
        color:#ffffff;
      ">
        ×
      </td>
    </tr>
  </table>
</td>
</tr>

<!-- STATUS BAR -->
<tr>
<td style="
  padding:7px 10px;
  background:#dedede;
  border-bottom:1px solid #999999;
  font-family:'Courier New', monospace;
  font-size:10px;
  color:#444444;
">
  MEMBERSHIP STATUS: <span style="color:#8b0000;">● REMOVED</span>
</td>
</tr>

<!-- CONTENT -->
<tr>
<td style="padding:42px 38px 45px;">

<!-- SMALL LABEL -->
<div style="
  font-family:'Courier New', monospace;
  font-size:10px;
  color:#777777;
  margin-bottom:18px;
 ">
  // MEMBERSHIP UPDATE
</div>

<!-- HEADLINE -->
<div style="
  font-family:Arial, Helvetica, sans-serif;
  font-size:46px;
  line-height:1;
  font-weight:bold;
  letter-spacing:-2px;
  color:#111111;
  margin-bottom:30px;
 ">
  REMOVED.
</div>

<!-- COPY -->
<div style="
  max-width:480px;
  font-size:14px;
  line-height:1.7;
  color:#333333;
  margin-bottom:30px;
 ">
  Hello {{.MemberName}},<br><br>

  You've been removed from
  <strong>{{.OrganizationName}}</strong> by {{.RemoverName}}.<br><br>

  If you believe this was a mistake, reach out to the
  organization owner.
</div>

<!-- DIVIDER -->
<table width="100%" cellpadding="0" cellspacing="0">
<tr>
<td style="
  height:1px;
  background:#aaaaaa;
  font-size:1px;
  line-height:1px;
 ">
  &nbsp;
</td>
</tr>
</table>

</td>
</tr>

<!-- FOOTER / STATUS -->
<tr>
<td style="
  padding:9px 12px;
  background:#dedede;
  border-top:1px solid #999999;
">
  <table width="100%" cellpadding="0" cellspacing="0">
    <tr>
      <td style="
        font-family:'Courier New', monospace;
        font-size:9px;
        color:#666666;
      ">
        DISILLUSIONED LABS // 001
      </td>
      <td align="right" style="
        font-family:'Courier New', monospace;
        font-size:9px;
        color:#666666;
      ">
        REMOVED
      </td>
    </tr>
  </table>
</td>
</tr>

</table>

<!-- OUTSIDE FOOTER -->
<table width="100%" cellpadding="0" cellspacing="0"
  style="max-width:620px;">
<tr>
<td align="center" style="
  padding:18px 10px;
  font-family:'Courier New', monospace;
  font-size:9px;
  line-height:1.6;
  color:#666666;
 ">
  DISILLUSIONED LABS<br>
  <span style="color:#888888;">We didn't say it was a good idea.</span>
</td>
</tr>
</table>

</td>
</tr>
</table>

</body>
</html>
