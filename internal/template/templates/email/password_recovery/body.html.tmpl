<!doctype html>
<html lang="en">
  <body style="margin:0;padding:32px;background:#f7f6f2;color:#202923;font:16px/1.5 Arial,sans-serif">
    <main style="max-width:560px;margin:auto;padding:32px;background:#fff;border:1px solid #deded7;border-radius:12px">
      <p style="margin-top:0;color:#626b64">BUKU BUKTI · ACCOUNT SECURITY</p>
      <h1 style="font-size:24px">Reset your password</h1>
      <p>Hello {{.Name}},</p>
      <p>Use this one-time link to choose a new password. It expires in 15 minutes.</p>
      <p><a href="{{.RecoveryURL}}" style="display:inline-block;padding:12px 18px;background:#245c45;color:#fff;text-decoration:none;border-radius:6px">Choose a new password</a></p>
      <p>If you did not request this, ignore this email. Your password will not change.</p>
    </main>
  </body>
</html>
